default_platform(:ios)

platform :ios do
  desc "Archive, sign, and upload an internal TestFlight build"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_BASE64"),
      is_key_content_base64: true
    )

    increment_build_number(
      build_number: ENV.fetch("GITHUB_RUN_NUMBER"),
      xcodeproj: "ios/App/App.xcodeproj"
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: { "com.nrashid7.shepherdai" => ENV.fetch("APPLE_PROVISIONING_PROFILE_NAME") }
      },
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='#{ENV.fetch('APPLE_PROVISIONING_PROFILE_NAME')}'"
    )

    upload_to_testflight(api_key: api_key, distribute_external: false, skip_waiting_for_build_processing: true)
  end
end
